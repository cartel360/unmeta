    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exifr": "7.1.3",
    "jszip": "3.10.1",
    "lucide-react": "1.61.0",
    "motion": "12.38.0",
    "next": "16.4.3",
