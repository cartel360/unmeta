{
  "name": "unmeta",
  "version": "1.0.0",
  "description": "Privacy-first browser image metadata inspector and remover",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postbuild": "node scripts/security-headers.mjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src tests scripts *.ts *.mjs *.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "overrides": {
    "framer-motion": "12.38.0",
    "motion-dom": "12.38.0",
